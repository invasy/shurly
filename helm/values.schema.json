{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": ["string", "null"] },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": ["string", "null"] },
        "annotations": { "type": "object" }
      }
    },
    "replicas": {
      "type": "object",
      "properties": {
        "api": { "type": "integer", "minimum": 0 },
        "worker": { "type": "integer", "minimum": 0 },
        "beat": { "type": "integer", "minimum": 0 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "env": {
      "type": "object",
      "patternProperties": {
        "^SHURLY_": { "type": ["string", "integer", "boolean", "null"] }
      }
    },
    "secretRef": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "databaseKey": { "type": "string" },
        "adminTokenKey": { "type": "string" }
      }
    },
    "migrate": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": ["string", "null"] }
      }
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "initialDelaySeconds": { "type": "integer" },
        "periodSeconds": { "type": "integer" },
        "timeoutSeconds": { "type": "integer" },
        "failureThreshold": { "type": "integer" }
      }
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string" },
        "initialDelaySeconds": { "type": "integer" },
        "periodSeconds": { "type": "integer" },
        "timeoutSeconds": { "type": "integer" },
        "failureThreshold": { "type": "integer" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "api": { "$ref": "#/definitions/resource" },
        "worker": { "$ref": "#/definitions/resource" },
        "beat": { "$ref": "#/definitions/resource" }
      }
    }
  },
  "definitions": {
    "resource": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    }
  }
}
