# shurly environment configuration
# Copy to `.env` and adjust. All variables are optional; defaults shown.
#
# In Docker Compose these map directly onto the containers' environment.

# --- application ---
SHURLY_ENVIRONMENT=development            # development | test | production
SHURLY_DEBUG=false
SHURLY_LOG_LEVEL=INFO
SHURLY_BASE_URL=http://localhost:8000     # used to build short_url values

# --- database (asyncpg) ---
SHURLY_DATABASE_URL=postgresql://shurly:shurly@localhost:5432/shurly
SHURLY_DB_POOL_SIZE=10
SHURLY_DB_MAX_OVERFLOW=20
SHURLY_DB_ECHO=false

# --- redis (cache + rate limit + Celery broker) ---
SHURLY_REDIS_URL=redis://localhost:6379/0
SHURLY_REDIS_CACHE_TTL=86400             # seconds; cache-aside TTL for URLs

# --- security / rate limiting ---
SHURLY_API_KEYS_ENABLED=true
SHURLY_RATE_LIMIT_ENABLED=true
SHURLY_DEFAULT_RATE_LIMIT=100            # requests / window (per key or IP)
SHURLY_RATE_LIMIT_WINDOW_SECONDS=60
SHURLY_ALLOW_LOCALHOST=true              # reject loopback/private targets in prod
SHURLY_ADMIN_TOKEN=                      # guard for list/revoke key endpoints

# --- code generation ---
SHURLY_CODE_STRATEGY=base62              # base62 | murmur3
SHURLY_CODE_LENGTH=7                     # 4..12; target width for hash codes
SHURLY_IDEMPOTENT=true                   # same (url, user) -> same code

# --- urls ---
SHURLY_MAX_URL_LENGTH=2048

# --- observability / integrations ---
SHURLY_SENTRY_DSN=
SHURLY_GEOIP_MMDB=                        # path to GeoLite2-Country.mmdb (opt.)

# --- process (used by `python -m app.main` / Docker CMD) ---
SHURLY_HOST=0.0.0.0
SHURLY_PORT=8000
SHURLY_WORKERS=1
